{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verilator: lint core filelist",
      "type": "shell",
      "command": "verilator",
      "args": [
        "--sv",
        "--lint-only",
        "--timing",
        "-Wall",
        "-Wno-fatal",
        "-Wno-MULTITOP",
        "-Wno-MODDUP",
        "-Wno-DECLFILENAME",
        "-Wno-TIMESCALEMOD",
        "-Wno-UNUSEDSIGNAL",
        "-f",
        "rtl/filelist.f"
      ],
      "group": "test",
      "problemMatcher": {
        "owner": "verilator",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^%(Warning|Error)(?:-[^:]+)?:\\s+([^:]+):(\\d+):(\\d+):\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Verilator: elaborate smoke",
      "type": "shell",
      "command": "verilator",
      "args": [
        "--sv",
        "--lint-only",
        "--timing",
        "-Wall",
        "-Wno-fatal",
        "-Werror-UNOPTFLAT",
        "-Wno-DECLFILENAME",
        "-Wno-TIMESCALEMOD",
        "-Wno-UNUSEDSIGNAL",
        "--top-module",
        "core_smoke_tb",
        "-f",
        "rtl/filelist.f",
        "tb/core_basic_smoke_tb.sv"
      ],
      "group": "test",
      "problemMatcher": {
        "owner": "verilator",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^%(Warning|Error)(?:-[^:]+)?:\\s+([^:]+):(\\d+):(\\d+):\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    }
  ]
}
